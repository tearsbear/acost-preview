# ==========================================================
# Environment Variables for AI Cost Tracker (acost) Web App
# Rename this file to .env.local and populate with your keys.
# ==========================================================

# 1. Supabase Credentials
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side ONLY key. Bypasses Row Level Security (RLS).
# CRITICAL: Keep this hidden and NEVER commit to GitHub.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# 2. Testing Credentials
# Required for running the E2E verification test pipeline.
OPENAI_API_KEY=your-openai-api-key
OPENAGENTIC_MODEL=gemini-3.8-flash-high
ACOST_API_KEY=your-acost-api-key
ACOST_BASE_URL=http://localhost:3001
NEXT_PUBLIC_ACOST_BASE_URL=http://localhost:3001/v1/track
ALLOW_REGISTER=false
NEXT_PUBLIC_ALLOW_REGISTER=false
